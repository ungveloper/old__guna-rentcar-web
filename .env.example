# 건아렌트카 환경변수 예시 (Git에 올라가는 설정 안내용 파일)
# 실제 설정값은 프로젝트 루트의 .env.local에만 입력하세요.
# .env.example에는 Notion 토큰 등 비밀정보를 절대 작성하지 마세요.

# 구매한 정식 도메인을 연결한 뒤 설정하세요. 예: https://example.com
NEXT_PUBLIC_SITE_URL=

# GA4 개인정보 고지 및 운영 준비가 끝난 경우에만 적용하세요.
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Notion 상담 요청 저장 (서버 전용 / NEXT_PUBLIC_ 접두사 사용 금지)
# Notion 통합: https://www.notion.so/profile/integrations
# 대상 데이터베이스를 통합에 공유하고 Database ID가 아닌 Data Source ID 사용
# 설정 및 자동화 안내: docs/NOTION_INQUIRIES_SETUP.md
NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=
